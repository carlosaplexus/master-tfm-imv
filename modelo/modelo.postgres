CREATE TABLE patients (
    id BIGSERIAL PRIMARY KEY,              -- ID interno del backend
    device_id TEXT NOT NULL,               -- Identificador del generador/dispositivo
    device_victim_seq INT NOT NULL,        -- Número incremental local del dispositivo
    edad INT NOT NULL,
    genero TEXT NOT NULL,
    lesion_principal TEXT NOT NULL,
    triage_asignado TEXT NOT NULL,
    frecuencia_cardiaca INT NOT NULL,
    frecuencia_respiratoria INT NOT NULL,
    presion_sistolica INT NOT NULL,
    glasgow INT NOT NULL,
    estado TEXT DEFAULT 'registrado',
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

CREATE UNIQUE INDEX ux_device_victim
ON patients(device_id, device_victim_seq);
