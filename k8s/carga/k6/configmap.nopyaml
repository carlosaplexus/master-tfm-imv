apiVersion: v1
kind: ConfigMap
metadata:
  name: k6-scripts
  namespace: imv-simulacion
data:
  imv_escenario1.js: |
    import http from 'k6/http';
    import { sleep } from 'k6';

    export default function () {
      http.get('http://backend.imv-simulacion.svc.cluster.local:5001');
      sleep(1);
    }
