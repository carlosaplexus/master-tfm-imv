            { "key": "pipeline_id", "operator": "=~", "value": "/^$pipeline_id$/" },
            { "key": "script_name", "operator": "=~", "value": "/^$script_name$/" }
          ]
        }
      ]
    },

    {
      "id": 8,
      "type": "row",
      "title": "Detalle por oleada (scenario = $scenario)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },

