{
  "uid": "k6-dashboard",
  "title": "K6 – IMV Performance (por escenario)",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "editable": true,
  "style": "dark",
  "tags": ["k6", "performance", "imv"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },

  "templating": {
    "list": [
      {
        "name": "pipeline_id",
        "label": "Pipeline",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"pipeline_id\"",
        "includeAll": true,
        "refresh": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "script_name",
        "label": "Script",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"script_name\"",
        "includeAll": true,
        "refresh": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "imv",
        "label": "Escenario IMV",
        "type": "constant",
        "query": "Escenario IMV",
        "current": {
          "text": "Escenario IMV",
          "value": "Escenario IMV"
        }
      },
      {
        "name": "scenario",
        "label": "Oleada (scenario)",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"scenario\"",
        "includeAll": false,
        "refresh": 1,
        "current": { "text": "oleada1_explosion", "value": "oleada1_explosion" }
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Resumen global",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "P95 Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "measurement": "http_req_duration",
          "groupBy": [
            { "type": "time", "params": ["$__interval"] },
            { "type": "fill", "params": ["null"] }
          ],
          "select": [
            [
              { "type": "field", "params": ["value"] },
              { "type": "percentile", "params": [95] }
            ]
          ],
          "tags": [
            { "key": "pipeline_id", "operator": "=~", "value": "/^$pipeline_id$/" },
            { "key": "script_name", "operator": "=~", "value": "/^$script_name$/" }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 400 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "P99 Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "measurement": "http_req_duration",
          "groupBy": [
            { "type": "time", "params": ["$__interval"] },
            { "type": "fill", "params": ["null"] }
          ],
          "select": [
            [
              { "type": "field", "params": ["value"] },
              { "type": "percentile", "params": [99] }
            ]
          ],
          "tags": [
            { "key": "pipeline_id", "operator": "=~", "value": "/^$pipeline_id$/" },
            { "key": "script_name", "operator": "=~", "value": "/^$script_name$/" }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 600 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Throughput (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "measurement": "http_reqs",
          "groupBy": [
            { "type": "time", "params": ["$__interval"] },
            { "type": "fill", "params": ["null"] }
          ],
          "select": [
            [
              { "type": "field", "params": ["value"] },
              { "type": "sum", "params": [] }
            ]
          ],
          "tags": [
            { "key": "pipeline_id", "operator": "=~", "value": "/^$pipeline_id$/" },
            { "key": "script_name", "operator": "=~", "value": "/^$script_name$/" }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red" },
              { "color": "yellow", "value": 500 },
              { "color": "green", "value": 1000 }
            ]
          }
        }
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Errores (%)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "measurement": "http_req_failed",
          "groupBy": [
            { "type": "time", "params": ["$__interval"] },
            { "type": "fill", "params": ["null"] }
          ],
          "select": [
            [
              { "type": "field", "params": ["value"] },
              { "type": "sum", "params": [] }
            ]
          ],
          "tags": [
            { "key": "pipeline_id", "operator": "=~", "value": "/^$pipeline_id$/" },
            { "key": "script_name", "operator": "=~", "value": "/^$script_name$/" }
          ]
        },
        {
          "refId": "B",
          "measurement": "http_reqs",
          "groupBy": [
            { "type": "time", "params": ["$__interval"] },
            { "type": "fill", "params": ["null"] }
          ],
          "select": [
            [
              { "type": "field", "params": ["value"] },
              { "type": "sum", "params": [] }
            ]
          ],
          "tags": [
            { "key": "pipeline_id", "operator": "=~", "value": "/^$pipeline_id$/" },
            { "key": "script_name", "operator": "=~", "value": "/^$script_name$/" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": { "reducer": "sum" },
            "alias": "error_pct",
            "binary": {
              "left": "A",
              "operator": "/",
              "right": "B"
            },
            "multiply": 100
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "type": "row",
      "title": "Línea temporal global",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

