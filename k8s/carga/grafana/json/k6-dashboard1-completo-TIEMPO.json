{
  "uid": "k6-dashboard-time",
  "title": "K6 – IMV Performance (por tiempo)",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "style": "dark",
  "tags": ["k6", "performance", "imv", "time-based"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pipeline_id",
        "label": "Pipeline",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"pipeline_id\"",
        "includeAll": true,
        "refresh": 1
      },
      {
        "name": "script_name",
        "label": "Script",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"script_name\"",
        "includeAll": true,
        "refresh": 1
      },
      {
        "name": "imv",
        "label": "IMV Escenario",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
        "query": "SHOW TAG VALUES FROM \"http_reqs\" WITH KEY = \"imv\"",
        "includeAll": true,
        "refresh": 1
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "KPIs Globales",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "P95 Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT percentile(\"value\",95) FROM \"http_req_duration\" WHERE $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 400 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "P99 Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT percentile(\"value\",99) FROM \"http_req_duration\" WHERE $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 600 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Throughput (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT sum(\"value\") / $__interval_s FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red" },
              { "color": "yellow", "value": 500 },
              { "color": "green", "value": 1000 }
            ]
          }
        }
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Errores (%)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT 100 * (sum(\"value\") / (SELECT sum(\"value\") FROM \"http_reqs\" WHERE $timeFilter)) FROM \"http_req_failed\" WHERE $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "type": "row",
      "title": "Línea temporal global",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia / Throughput / VUs / Errores",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "P95 Latency",
          "query": "SELECT percentile(\"value\",95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval)"
        },
        {
          "refId": "B",
          "alias": "Throughput",
          "query": "SELECT sum(\"value\") / $__interval_s FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval)"
        },
        {
          "refId": "C",
          "alias": "VUs",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval)"
        },
        {
          "refId": "D",
          "alias": "Errores",
          "query": "SELECT sum(\"value\") FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval)"
        }
      ]
    },

    {
      "id": 8,
      "type": "row",
      "title": "Oleada 1 (0s → 90s)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Latencia Oleada 1",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "P95 Latency O1",
          "query": "SELECT percentile(\"value\",95) FROM \"http_req_duration\" WHERE time >= now() - 930s AND time < now() - 840s GROUP BY time($__interval)"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Throughput / VUs / Errores Oleada 1",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "Throughput O1",
          "query": "SELECT sum(\"value\") / $__interval_s FROM \"http_reqs\" WHERE time >= now() - 930s AND time < now() - 840s GROUP BY time($__interval)"
        },
        {
          "refId": "B",
          "alias": "VUs O1",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE time >= now() - 930s AND time < now() - 840s GROUP BY time($__interval)"
        },
        {
          "refId": "C",
          "alias": "Errores O1",
          "query": "SELECT sum(\"value\") FROM \"http_req_failed\" WHERE time >= now() - 930s AND time < now() - 840s GROUP BY time($__interval)"
        }
      ]
    },

    {
      "id": 11,
      "type": "row",
      "title": "Oleada 2 (90s → 330s)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Latencia Oleada 2",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "P95 Latency O2",
          "query": "SELECT percentile(\"value\",95) FROM \"http_req_duration\" WHERE time >= now() - 840s AND time < now() - 600s GROUP BY time($__interval)"
        }
      ]
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "Throughput / VUs / Errores Oleada 2",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "Throughput O2",
          "query": "SELECT sum(\"value\") / $__interval_s FROM \"http_reqs\" WHERE time >= now() - 840s AND time < now() - 600s GROUP BY time($__interval)"
        },
        {
          "refId": "B",
          "alias": "VUs O2",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE time >= now() - 840s AND time < now() - 600s GROUP BY time($__interval)"
        },
        {
          "refId": "C",
          "alias": "Errores O2",
          "query": "SELECT sum(\"value\") FROM \"http_req_failed\" WHERE time >= now() - 840s AND time < now() - 600s GROUP BY time($__interval)"
        }
      ]
    },

    {
      "id": 14,
      "type": "row",
      "title": "Oleada 3 (330s → 930s)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Latencia Oleada 3",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "P95 Latency O3",
          "query": "SELECT percentile(\"value\",95) FROM \"http_req_duration\" WHERE time >= now() - 600s AND time < now() GROUP BY time($__interval)"
        }
      ]
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "Throughput / VUs / Errores Oleada 3",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "targets": [
        {
          "refId": "A",
          "alias": "Throughput O3",
          "query": "SELECT sum(\"value\") / $__interval_s FROM \"http_reqs\" WHERE time >= now() - 600s AND time < now() GROUP BY time($__interval)"
        },
        {
          "refId": "B",
          "alias": "VUs O3",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE time >= now() - 600s AND time < now() GROUP BY time($__interval)"
        },
        {
          "refId": "C",
          "alias": "Errores O3",
          "query": "SELECT sum(\"value\") FROM \"http_req_failed\" WHERE time >= now() - 600s AND time < now() GROUP BY time($__interval)"
        }
      ]
    }
  ]
}

