apiVersion: v1
kind: ServiceAccount
metadata:
  name: backend-sa
  namespace: imv-simulacion
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: backend-job-role
  namespace: imv-simulacion
rules:
- apiGroups: ["batch"]
  resources: ["jobs"]
  verbs: ["create", "get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: backend-job-binding
  namespace: imv-simulacion
subjects:
- kind: ServiceAccount
  name: backend-sa
  namespace: imv-simulacion
roleRef:
  kind: Role
  name: backend-job-role
  apiGroup: rbac.authorization.k8s.io
