apiVersion: apps/v1
kind: Deployment
metadata:
  name: k6
  namespace: imv-simulacion
spec:
  replicas: 1
  selector:
    matchLabels:
      app: k6
  template:
    metadata:
      labels:
        app: k6
    spec:
      containers:
      - name: k6
        image: grafana/k6:latest
        command: ["sh", "-c"]
        args:
          - |
            echo "▶ Iniciando ejecución de todos los scripts K6..."
            for f in /scripts/*.js; do
              echo "▶ Ejecutando $f"
              k6 run "$f"
              echo "▶ Finalizado $f"
            done
            echo "▶ Todos los tests de carga completados"
        volumeMounts:
        - name: k6-scripts
          mountPath: /scripts
      volumes:
      - name: k6-scripts
        configMap:
          name: k6-scripts

