apiVersion: apps/v1
kind: Deployment
metadata:
  name: k6
  namespace: imv-simulacion
spec:
  replicas: 1
  selector:
    matchLabels:
      app: k6
  template:
    metadata:
      labels:
        app: k6
    spec:
      containers:
      - name: k6
        image: grafana/k6:latest
        command: ["k6"]
        args: ["run", "/scripts/imv_escenario1.js"]
        volumeMounts:
        - name: k6-scripts
          mountPath: /scripts
      volumes:
      - name: k6-scripts
        configMap:
          name: k6-scripts
